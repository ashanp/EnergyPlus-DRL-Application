!=======================================================================
! UAE DUBAI HVAC BASELINE MODEL
! EnergyPlus 26.1.0
!
! Location:
!   Dubai World Central / Al Maktoum International Airport
!
! Weather:
!   ARE_DU_Dubai.World.Central.Intl.AP-Maktoum.Intl.AP.411945_TMYx.2007-2021.epw
!
! Building:
!   Single zone
!   10m x 10m x 3m
!   100 m2 floor area
!   300 m3 approximate volume
!
! HVAC:
!   Packaged Terminal Air Conditioner
!   DX cooling
!   Electric heating
!   Autosized
!
! Cooling thermostat:
!   24 C
!
! Designed as a baseline for later:
!   PPO / DQN HVAC optimisation
!
!=======================================================================


Version,
    26.1;


!=======================================================================
! SIMULATION CONTROL
!=======================================================================

SimulationControl,
    Yes,             !- Do Zone Sizing Calculation
    Yes,             !- Do System Sizing Calculation
    No,              !- Do Plant Sizing Calculation
    Yes,             !- Run Simulation for Sizing Periods
    Yes;             !- Run Simulation for Weather File Run Periods


SizingPeriod:DesignDay,
    Dubai Winter 99% Design Conditions, !- Name
    1,                        !- Month
    21,                       !- Day of Month
    WinterDesignDay,          !- Day Type
    11.0,                     !- Maximum Dry-Bulb Temperature [C]
    0.0,                      !- Daily Dry-Bulb Temperature Range [C]
    ,                         !- Default Safety Factor
    ,                         !- Fraction of Daily Range Schedule Name
    WetBulb,                  !- Humidity Condition Type
    11.0,                     !- Wetbulb or DewPoint at Maximum Dry-Bulb [C]
    ,                         !- Humidity Condition Day Schedule Name
    ,                         !- Humidity Ratio at Maximum Dry-Bulb [kgWater/kgDryAir]
    ,                         !- Enthalpy at Maximum Dry-Bulb [J/kg]
    ,                         !- Daily Wet-Bulb Temperature Range [C]
    101325.0,                 !- Barometric Pressure [Pa]
    3.0,                      !- Wind Speed [m/s]
    180,                      !- Wind Direction [deg]
    No,                       !- Rain Indicator
    No,                       !- Snow Indicator
    No,                       !- Daylight Saving Time Indicator
    ASHRAEClearSky,           !- Solar Model Indicator
    ,                         !- Beam Solar Day Schedule Name
    ,                         !- Diffuse Solar Day Schedule Name
    ,                         !- ASHRAE Clear Sky Optical Depth For Beam Irradiance (taub)
    ,                         !- ASHRAE Clear Sky Optical Depth For Diffuse Irradiance (taud)
    0.0;                      !- Sky Clearness (0.0 = No Solar Gain)


SizingPeriod:DesignDay,
    Dubai Summer 1% Design Conditions, !- Name
    7,                        !- Month
    21,                       !- Day of Month
    SummerDesignDay,          !- Day Type
    42.0,                     !- Maximum Dry-Bulb Temperature [C]
    9.0,                      !- Daily Dry-Bulb Temperature Range [C]
    ,                         !- Default Safety Factor
    ,                         !- Fraction of Daily Range Schedule Name
    WetBulb,                  !- Humidity Condition Type
    27.0,                     !- Wetbulb or DewPoint at Maximum Dry-Bulb [C]
    ,                         !- Humidity Condition Day Schedule Name
    ,                         !- Humidity Ratio at Maximum Dry-Bulb [kgWater/kgDryAir]
    ,                         !- Enthalpy at Maximum Dry-Bulb [J/kg]
    ,                         !- Daily Wet-Bulb Temperature Range [C]
    101325.0,                 !- Barometric Pressure [Pa]
    3.0,                      !- Wind Speed [m/s]
    180,                      !- Wind Direction [deg]
    No,                       !- Rain Indicator
    No,                       !- Snow Indicator
    No,                       !- Daylight Saving Time Indicator
    ASHRAEClearSky,           !- Solar Model Indicator
    ,                         !- Beam Solar Day Schedule Name
    ,                         !- Diffuse Solar Day Schedule Name
    ,                         !- ASHRAE Clear Sky Optical Depth For Beam Irradiance (taub)
    ,                         !- ASHRAE Clear Sky Optical Depth For Diffuse Irradiance (taud)
    1.0;                      !- Sky Clearness (1.0 = Full Solar Gain)


Timestep,
    4;                        !- Number of Timesteps per Hour (4 = 15-minute simulation intervals)


!=======================================================================
! BUILDING
!=======================================================================

Building,
    UAE Dubai Baseline,            !- Name
    0.0,                           !- North Axis [deg] (0.0 = True North alignment)
    Suburbs,                       !- Terrain Type (Affects ground roughness & wind velocity profile)
    0.04,                          !- Loads Convergence Tolerance Value [W]
    0.4,                           !- Temperature Convergence Tolerance Value [delta C]
    FullExteriorWithReflections,   !- Solar Distribution (Includes exterior reflections & shadow calculations)
    25;                            !- Maximum Number of Warmup Days (Upper limit for thermal stabilization)


!=======================================================================
! LOCATION
!
! The EPW file supplied with -w is the actual weather source.
!=======================================================================

Site:Location,
    Dubai World Central,           !- Name
    24.896,                        !- Latitude [deg] (North)
    55.161,                        !- Longitude [deg] (East)
    4.0,                           !- Time Zone [hr] (UTC+4 for UAE)
    36.0;                          !- Elevation [m] (Above sea level, matched to EPW weather file header)[cite: 1]


!=======================================================================
! GROUND TEMPERATURE
!=======================================================================

Site:GroundTemperature:BuildingSurface,
    24.0,                          !- January Ground Temperature [C]
    24.0,                          !- February Ground Temperature [C]
    25.0,                          !- March Ground Temperature [C]
    27.0,                          !- April Ground Temperature [C]
    30.0,                          !- May Ground Temperature [C]
    32.0,                          !- June Ground Temperature [C]
    33.0,                          !- July Ground Temperature [C]
    33.0,                          !- August Ground Temperature [C]
    32.0,                          !- September Ground Temperature [C]
    30.0,                          !- October Ground Temperature [C]
    27.0,                          !- November Ground Temperature [C]
    25.0;                          !- December Ground Temperature [C]


!=======================================================================
! GLOBAL GEOMETRY
!=======================================================================

GlobalGeometryRules,
    UpperLeftCorner,               !- Starting Vertex Position (First vertex starts at upper-left corner of surface)
    CounterClockWise,              !- Vertex Entry Direction (Vertices specified counter-clockwise facing outwards)
    World;                         !- Coordinate System (3D World/Global coordinates relative to origin)


!=======================================================================
! ZONE
!=======================================================================

Zone,
    Main Zone,               !- Name
    0.0,                     !- Direction of Relative North [deg]
    0.0,                     !- X Origin [m]
    0.0,                     !- Y Origin [m]
    0.0,                     !- Z Origin [m]
    1,                       !- Type
    1,                       !- Multiplier
    autocalculate,           !- Ceiling Height [m]
    autocalculate;           !- Volume [m3]


!=======================================================================
! MATERIALS
!=======================================================================

Material,
    External Wall Material,        !- Name
    MediumRough,                   !- Roughness (Surface texture used for exterior convection calculations)
    0.200,                         !- Thickness [m] (200 mm exterior wall layer)
    1.40,                          !- Thermal Conductivity [W/m-K] (Standard concrete/masonry value)
    2200.0,                        !- Density [kg/m3] (High thermal mass material)
    900.0,                         !- Specific Heat [J/kg-K]
    0.90,                          !- Thermal Absorptance (Long-wave emissivity, 0.90 standard)
    0.70,                          !- Solar Absorptance (Fraction of direct/diffuse solar radiation absorbed)
    0.70;                          !- Visible Absorptance (Fraction of visible light spectrum absorbed)


Material,
    Roof Material,                 !- Name
    MediumRough,                   !- Roughness
    0.180,                         !- Thickness [m] (180 mm roof layer)
    1.40,                          !- Thermal Conductivity [W/m-K]
    2200.0,                        !- Density [kg/m3]
    900.0,                         !- Specific Heat [J/kg-K]
    0.90,                          !- Thermal Absorptance
    0.70,                          !- Solar Absorptance
    0.70;                          !- Visible Absorptance


Material,
    Floor Material,                !- Name
    MediumRough,                   !- Roughness
    0.150,                         !- Thickness [m] (150 mm floor slab)
    1.40,                          !- Thermal Conductivity [W/m-K]
    2200.0,                        !- Density [kg/m3]
    900.0,                         !- Specific Heat [J/kg-K]
    0.90,                          !- Thermal Absorptance
    0.70,                          !- Solar Absorptance
    0.70;                          !- Visible Absorptance


!=======================================================================
! WINDOW
!=======================================================================

WindowMaterial:SimpleGlazingSystem,
    Double Glazing,                !- Name
    2.70,                          !- U-Factor [W/m2-K] (Overall heat transfer coefficient including air films)
    0.40,                          !- Solar Heat Gain Coefficient (SHGC; fraction of solar radiation admitted)
    0.30;                          !- Visible Transmittance (Fraction of visible light transmitted)


!=======================================================================
! CONSTRUCTIONS
!=======================================================================

Construction,
    External Wall Construction,    !- Name
    External Wall Material;        !- Outside Layer (References Material object)


Construction,
    Roof Construction,             !- Name
    Roof Material;                 !- Outside Layer (References Material object)


Construction,
    Floor Construction,            !- Name
    Floor Material;                !- Outside Layer (References Material object)


Construction,
    Window Construction,           !- Name
    Double Glazing;                !- Outside Layer (References WindowMaterial object)

!=======================================================================
! SOUTH WALL
!=======================================================================

BuildingSurface:Detailed,
    South Wall,                    !- Name
    Wall,                          !- Surface Type
    External Wall Construction,    !- Construction Name
    Main Zone,                     !- Zone Name
    ,                              !- Space Name
    Outdoors,                      !- Outside Boundary Condition
    ,                              !- Outside Boundary Condition Object
    SunExposed,                    !- Sun Exposure
    WindExposed,                   !- Wind Exposure
    0.5,                           !- View Factor to Ground
    4,                             !- Number of Vertices
    0.0, 0.0, 0.0,                 !- Vertex 1 X,Y,Z [m] (Bottom-Left)
    10.0, 0.0, 0.0,                !- Vertex 2 X,Y,Z [m] (Bottom-Right)
    10.0, 0.0, 3.0,                !- Vertex 3 X,Y,Z [m] (Top-Right)
    0.0, 0.0, 3.0;                 !- Vertex 4 X,Y,Z [m] (Top-Left)


!=======================================================================
! NORTH WALL
!=======================================================================

BuildingSurface:Detailed,
    North Wall,                    !- Name
    Wall,                          !- Surface Type
    External Wall Construction,    !- Construction Name
    Main Zone,                     !- Zone Name
    ,                              !- Space Name
    Outdoors,                      !- Outside Boundary Condition
    ,                              !- Outside Boundary Condition Object
    SunExposed,                    !- Sun Exposure
    WindExposed,                   !- Wind Exposure
    0.5,                           !- View Factor to Ground
    4,                             !- Number of Vertices
    0.0, 10.0, 0.0,                !- Vertex 1 X,Y,Z [m] (Bottom-Left)
    10.0, 10.0, 0.0,               !- Vertex 2 X,Y,Z [m] (Bottom-Right)
    10.0, 10.0, 3.0,               !- Vertex 3 X,Y,Z [m] (Top-Right)
    0.0, 10.0, 3.0;                !- Vertex 4 X,Y,Z [m] (Top-Left)


!=======================================================================
! EAST WALL
!=======================================================================

BuildingSurface:Detailed,
    East Wall,                     !- Name
    Wall,                          !- Surface Type
    External Wall Construction,    !- Construction Name
    Main Zone,                     !- Zone Name
    ,                              !- Space Name
    Outdoors,                      !- Outside Boundary Condition
    ,                              !- Outside Boundary Condition Object
    SunExposed,                    !- Sun Exposure
    WindExposed,                   !- Wind Exposure
    0.5,                           !- View Factor to Ground
    4,                             !- Number of Vertices
    10.0, 0.0, 0.0,                !- Vertex 1 X,Y,Z [m] (Bottom-Left)
    10.0, 10.0, 0.0,               !- Vertex 2 X,Y,Z [m] (Bottom-Right)
    10.0, 10.0, 3.0,               !- Vertex 3 X,Y,Z [m] (Top-Right)
    10.0, 0.0, 3.0;                !- Vertex 4 X,Y,Z [m] (Top-Left)


!=======================================================================
! WEST WALL
!=======================================================================

BuildingSurface:Detailed,
    West Wall,                     !- Name
    Wall,                          !- Surface Type
    External Wall Construction,    !- Construction Name
    Main Zone,                     !- Zone Name
    ,                              !- Space Name
    Outdoors,                      !- Outside Boundary Condition
    ,                              !- Outside Boundary Condition Object
    SunExposed,                    !- Sun Exposure
    WindExposed,                   !- Wind Exposure
    0.5,                           !- View Factor to Ground
    4,                             !- Number of Vertices
    0.0, 10.0, 0.0,                !- Vertex 1 X,Y,Z [m] (Bottom-Left)
    0.0, 0.0, 0.0,                 !- Vertex 2 X,Y,Z [m] (Bottom-Right)
    0.0, 0.0, 3.0,                 !- Vertex 3 X,Y,Z [m] (Top-Right)
    0.0, 10.0, 3.0;                !- Vertex 4 X,Y,Z [m] (Top-Left)


!=======================================================================
! ROOF
!=======================================================================

BuildingSurface:Detailed,
    Roof,                          !- Name
    Roof,                          !- Surface Type
    Roof Construction,             !- Construction Name
    Main Zone,                     !- Zone Name
    ,                              !- Space Name
    Outdoors,                      !- Outside Boundary Condition
    ,                              !- Outside Boundary Condition Object
    SunExposed,                    !- Sun Exposure
    WindExposed,                   !- Wind Exposure
    0.0,                           !- View Factor to Ground (0.0 for horizontal roof facing sky)
    4,                             !- Number of Vertices
    0.0, 0.0, 3.0,                 !- Vertex 1 X,Y,Z [m] (South-West Corner)
    10.0, 0.0, 3.0,                !- Vertex 2 X,Y,Z [m] (South-East Corner)
    10.0, 10.0, 3.0,               !- Vertex 3 X,Y,Z [m] (North-East Corner)
    0.0, 10.0, 3.0;                !- Vertex 4 X,Y,Z [m] (North-West Corner)


!=======================================================================
! FLOOR
!=======================================================================

BuildingSurface:Detailed,
    Floor,                         !- Name
    Floor,                         !- Surface Type
    Floor Construction,            !- Construction Name
    Main Zone,                     !- Zone Name
    ,                              !- Space Name
    Ground,                        !- Outside Boundary Condition (Coupled with Site:GroundTemperature)
    ,                              !- Outside Boundary Condition Object
    NoSun,                         !- Sun Exposure (Shielded from solar radiation)
    NoWind,                        !- Wind Exposure (Shielded from wind)
    0.0,                           !- View Factor to Ground
    4,                             !- Number of Vertices
    0.0, 0.0, 0.0,                 !- Vertex 1 X,Y,Z [m] (South-West Corner)
    0.0, 10.0, 0.0,                !- Vertex 2 X,Y,Z [m] (North-West Corner)
    10.0, 10.0, 0.0,               !- Vertex 3 X,Y,Z [m] (North-East Corner)
    10.0, 0.0, 0.0;                !- Vertex 4 X,Y,Z [m] (South-East Corner)


!=======================================================================
! WINDOWS
!
! Each window = 4m x 1.5m = 6m2
! Four windows = 24m2
!=======================================================================

FenestrationSurface:Detailed,
    South Window,            !- Name
    Window,                  !- Surface Type
    Window Construction,     !- Construction Name
    South Wall,              !- Building Surface Name
    ,                        !- Outside Boundary Condition Object
    1.0,                     !- View Factor to Ground
    ,                        !- Frame and Divider Name
    1.0,                     !- Multiplier
    4,                       !- Number of Vertices
    3.0, 0.0, 1.0,           !- Vertex 1 X,Y,Z [m]
    7.0, 0.0, 1.0,           !- Vertex 2 X,Y,Z [m]
    7.0, 0.0, 2.5,           !- Vertex 3 X,Y,Z [m]
    3.0, 0.0, 2.5;           !- Vertex 4 X,Y,Z [m]

FenestrationSurface:Detailed,
    North Window,            !- Name
    Window,                  !- Surface Type
    Window Construction,     !- Construction Name
    North Wall,              !- Building Surface Name
    ,                        !- Outside Boundary Condition Object
    1.0,                     !- View Factor to Ground
    ,                        !- Frame and Divider Name
    1.0,                     !- Multiplier
    4,                       !- Number of Vertices
    3.0, 10.0, 1.0,          !- Vertex 1 X,Y,Z [m]
    7.0, 10.0, 1.0,          !- Vertex 2 X,Y,Z [m]
    7.0, 10.0, 2.5,          !- Vertex 3 X,Y,Z [m]
    3.0, 10.0, 2.5;          !- Vertex 4 X,Y,Z [m]

FenestrationSurface:Detailed,
    East Window,             !- Name
    Window,                  !- Surface Type
    Window Construction,     !- Construction Name
    East Wall,               !- Building Surface Name
    ,                        !- Outside Boundary Condition Object
    1.0,                     !- View Factor to Ground
    ,                        !- Frame and Divider Name
    1.0,                     !- Multiplier
    4,                       !- Number of Vertices
    10.0, 3.0, 1.0,          !- Vertex 1 X,Y,Z [m]
    10.0, 7.0, 1.0,          !- Vertex 2 X,Y,Z [m]
    10.0, 7.0, 2.5,          !- Vertex 3 X,Y,Z [m]
    10.0, 3.0, 2.5;          !- Vertex 4 X,Y,Z [m]

FenestrationSurface:Detailed,
    West Window,             !- Name
    Window,                  !- Surface Type
    Window Construction,     !- Construction Name
    West Wall,               !- Building Surface Name
    ,                        !- Outside Boundary Condition Object
    1.0,                     !- View Factor to Ground
    ,                        !- Frame and Divider Name
    1.0,                     !- Multiplier
    4,                       !- Number of Vertices
    0.0, 7.0, 1.0,           !- Vertex 1 X,Y,Z [m]
    0.0, 3.0, 1.0,           !- Vertex 2 X,Y,Z [m]
    0.0, 3.0, 2.5,           !- Vertex 3 X,Y,Z [m]
    0.0, 7.0, 2.5;           !- Vertex 4 X,Y,Z [m]


!=======================================================================
! SCHEDULE TYPE LIMITS
!=======================================================================

ScheduleTypeLimits,
    Fraction,                      !- Name
    0.0,                           !- Lower Limit Value (Minimum fraction allowed)
    1.0,                           !- Upper Limit Value (Maximum fraction allowed)
    Continuous;                    !- Numeric Type (Floating-point values allowed)


ScheduleTypeLimits,
    Temperature,                   !- Name
    -60.0,                         !- Lower Limit Value [C] (Minimum allowable temperature)
    200.0,                         !- Upper Limit Value [C] (Maximum allowable temperature)
    Continuous;                    !- Numeric Type (Floating-point values allowed)


ScheduleTypeLimits,
    Control Type,                  !- Name
    0,                             !- Lower Limit Value (0 = Uncontrolled / Off)
    4,                             !- Upper Limit Value (4 = Dual Setpoint with Deadband)
    Discrete;                      !- Numeric Type (Integer values only)


!=======================================================================
! OCCUPANCY
!=======================================================================

Schedule:Compact,
    Occupancy Schedule,            !- Name
    Fraction,                      !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1 (Valid for entire year)
    For: Weekdays SummerDesignDay, !- Field 2 (Applies to regular weekdays and peak cooling sizing)[cite: 1]
    Until: 08:00, 0.0,             !- Field 3-4 (Unoccupied before 8 AM)
    Until: 09:00, 0.5,             !- Field 5-6 (50% occupancy ramp-up hour)
    Until: 18:00, 1.0,             !- Field 7-8 (100% full occupancy during work hours)
    Until: 19:00, 0.5,             !- Field 9-10 (50% occupancy ramp-down hour)
    Until: 24:00, 0.0,             !- Field 11-12 (Unoccupied after 7 PM)
    For: Weekends WinterDesignDay Holiday AllOtherDays, !- Field 13 (Covers off-days and winter sizing)[cite: 1]
    Until: 24:00, 0.0;             !- Field 14-15 (Unoccupied all day)


ScheduleTypeLimits,
    Activity,                      !- Name
    0.0,                           !- Lower Limit Value [W/person]
    200.0,                         !- Upper Limit Value [W/person]
    Continuous;                    !- Numeric Type


Schedule:Constant,
    People Activity Schedule,      !- Name
    Activity,                      !- Schedule Type Limits Name
    120.0;                         !- Hourly Value [W/person] (Standard light office work activity level)


People,
    Main Zone Occupants,           !- Name
    Main Zone,                     !- Zone Name
    Occupancy Schedule,            !- Number of People Schedule Name
    People,                        !- Number of People Calculation Method
    10,                            !- Number of People
    ,                              !- People per Zone Floor Area [person/m2]
    ,                              !- Zone Floor Area per Person [m2/person]
    0.3,                           !- Fraction Radiant (30% radiant internal heat gain)
    0.5,                           !- Sensible Heat Fraction (Autocalculated sensible/latent split toggle)
    People Activity Schedule;      !- Activity Level Schedule Name


!=======================================================================
! LIGHTING
!=======================================================================

Schedule:Compact,
    Lighting Schedule,             !- Name
    Fraction,                      !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1 (Valid for entire year)
    For: Weekdays SummerDesignDay, !- Field 2 (Applies to regular weekdays and peak cooling sizing)[cite: 1]
    Until: 08:00, 0.1,             !- Field 3-4 (10% setback lighting overnight)
    Until: 09:00, 0.5,             !- Field 5-6 (50% lighting ramp-up hour)
    Until: 18:00, 1.0,             !- Field 7-8 (100% full lighting during work hours)
    Until: 19:00, 0.5,             !- Field 9-10 (50% lighting ramp-down hour)
    Until: 24:00, 0.1,             !- Field 11-12 (10% setback lighting overnight)
    For: Weekends WinterDesignDay Holiday AllOtherDays, !- Field 13 (Covers off-days and winter sizing)[cite: 1]
    Until: 24:00, 0.1;             !- Field 14-15 (10% setback lighting all day)


Lights,
    Main Zone Lights,              !- Name
    Main Zone,                     !- Zone Name
    Lighting Schedule,             !- Schedule Name
    LightingLevel,                 !- Design Level Calculation Method
    800.0,                         !- Design Level [W] (Total lighting power for the zone)
    ,                              !- Watts per Zone Floor Area [W/m2]
    ,                              !- Watts per Person [W/person]
    0.0,                           !- Return Air Fraction (Fraction of heat conducted into return air stream)
    0.42,                          !- Fraction Radiant (42% long-wave radiant heat output)
    0.18,                          !- Fraction Visible (18% visible light spectrum radiation)
    1.0,                           !- Fraction Replaceable (1.0 = All energy converts to heat eventually)
    General;                       !- End-Use Subcategory (Used for end-use energy consumption breakdown)


!=======================================================================
! ELECTRICAL EQUIPMENT
!=======================================================================

Schedule:Compact,
    Equipment Schedule,            !- Name
    Fraction,                      !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1 (Valid for entire year)
    For: Weekdays SummerDesignDay, !- Field 2 (Applies to regular weekdays and peak cooling sizing)
    Until: 08:00, 0.1,             !- Field 3-4 (10% standby equipment power overnight)
    Until: 09:00, 0.5,             !- Field 5-6 (50% equipment load ramp-up hour)
    Until: 18:00, 1.0,             !- Field 7-8 (100% full operating load during work hours)
    Until: 19:00, 0.5,             !- Field 9-10 (50% equipment load ramp-down hour)
    Until: 24:00, 0.1,             !- Field 11-12 (10% standby equipment power overnight)
    For: Weekends WinterDesignDay Holiday AllOtherDays, !- Field 13 (Covers off-days and winter sizing)
    Until: 24:00, 0.1;             !- Field 14-15 (10% standby equipment load all day)


ElectricEquipment,
    Main Zone Equipment,           !- Name
    Main Zone,                     !- Zone Name
    Equipment Schedule,            !- Schedule Name
    EquipmentLevel,                !- Design Level Calculation Method
    1000.0,                        !- Design Level [W] (Total equipment electric power for 100m2 zone)
    ,                              !- Watts per Zone Floor Area [W/m2]
    ,                              !- Watts per Person [W/person]
    0.30,                          !- Fraction Latent (30% latent heat gain from office equipment)
    0.0,                           - Fraction Radiant (0% direct long-wave radiation)
    0.0,                           !- Fraction Lost (0% heat lost to environment outside zone)
    General;                       !- End-Use Subcategory (End-use energy accounting classification)


!=======================================================================
! INFILTRATION
!=======================================================================

Schedule:Constant,
    Infiltration Schedule,         !- Name
    Fraction,                      !- Schedule Type Limits Name
    1.0;                           !- Hourly Value (Continuous baseline infiltration)


ZoneInfiltration:DesignFlowRate,
    Main Zone Infiltration,        !- Name
    Main Zone,                     !- Zone Name
    Infiltration Schedule,         !- Schedule Name
    Flow/Zone,                     !- Design Flow Rate Calculation Method
    0.0003,                        !- Design Flow Rate [m3/s] (~1.08 m3/h baseline air leakage)
    ,                              !- Flow per Zone Floor Area [m3/s-m2]
    ,                              !- Flow per Exterior Surface Area [m3/s-m2]
    ,                              !- Air Changes per Hour [1/hr]
    1.0,                           !- Constant Term Coefficient (A = 1.0; independent of temperature or wind)
    0.0,                           !- Temperature Term Coefficient (B = 0.0)
    0.0,                           !- Velocity Term Coefficient (C = 0.0)
    0.0;                           !- Velocity Squared Term Coefficient (D = 0.0)


!=======================================================================
! THERMOSTAT
!
! Heating = 20 C
! Cooling = 24 C
!=======================================================================

Schedule:Compact,
    Heating Setpoint Schedule,     !- Name
    Temperature,                   !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1 (Valid year-round)
    For: AllDays,                  !- Field 2 (Applies every day)
    Until: 24:00, 20.0;            !- Field 3-4 (Constant 20.0 C heating setpoint)


Schedule:Compact,
    Cooling Setpoint Schedule,     !- Name
    Temperature,                   !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1 (Valid year-round)
    For: AllDays,                  !- Field 2 (Applies every day)
    Until: 24:00, 24.0;            !- Field 3-4 (Constant 24.0 C cooling setpoint)


Schedule:Compact,
    Thermostat Control Schedule,   !- Name
    Control Type,                  !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1 (Valid year-round)
    For: AllDays,                  !- Field 2 (Applies every day)
    Until: 24:00, 4;               !- Field 3-4 (Type 4 = Dual Setpoint with Deadband)


ThermostatSetpoint:DualSetpoint,
    Main Zone Dual Setpoint,       !- Name
    Heating Setpoint Schedule,     !- Heating Setpoint Temperature Schedule Name
    Cooling Setpoint Schedule;     !- Cooling Setpoint Temperature Schedule Name


ZoneControl:Thermostat,
    Main Zone Thermostat,          !- Name
    Main Zone,                     !- Zone Name
    Thermostat Control Schedule,   !- Control Type Schedule Name
    ThermostatSetpoint:DualSetpoint, !- Control 1 Object Type
    Main Zone Dual Setpoint;       !- Control 1 Name


Sizing:Zone,
    Main Zone,                     !- Zone Name
    SupplyAirTemperature,          !- Zone Cooling Design Supply Air Temperature Input Method
    14.0,                          !- Zone Cooling Design Supply Air Temperature [C]
    ,                              !- Zone Cooling Design Supply Air Temperature Difference [deltaC]
    SupplyAirTemperature,          !- Zone Heating Design Supply Air Temperature Input Method
    50.0,                          !- Zone Heating Design Supply Air Temperature [C]
    ,                              !- Zone Heating Design Supply Air Temperature Difference [deltaC]
    0.009,                         !- Zone Cooling Design Supply Air Humidity Ratio [kgWater/kgDryAir]
    0.004,                         !- Zone Heating Design Supply Air Humidity Ratio [kgWater/kgDryAir]
    ,                              !- Design Zone Air Distribution Effectivity Header
    0.0,                           !- Design Zone Air Distribution Effectivity [dimensionless]
    0.0,                           !- Design Zone Secondary Recirculation Fraction [dimensionless]
    DesignDayWithLimit,            !- Cooling Design Air Flow Method
    ,                              !- Cooling Design Air Flow Rate [m3/s]
    ,                              !- Cooling Minimum Air Flow per Zone Floor Area [m3/s-m2]
    ,                              !- Cooling Minimum Air Flow [m3/s]
    ,                              !- Cooling Minimum Air Flow Fraction [dimensionless]
    DesignDay,                     !- Heating Design Air Flow Method
    ,                              !- Heating Design Air Flow Rate [m3/s]
    ,                              !- Heating Maximum Air Flow per Zone Floor Area [m3/s-m2]
    ,                              !- Heating Maximum Air Flow [m3/s]
    ,                              !- Heating Maximum Air Flow Fraction [dimensionless]
    ,                              !- Outdoor Air Method
    No,                            !- Dedicated Outdoor Air System Control Strategy
    NeutralSupplyAir,              !- Dedicated Outdoor Air Low Setpoint Temperature for Design [C]
    autosize,                      !- Dedicated Outdoor Air High Setpoint Temperature for Design [C]
    autosize,                      !- Zone Cooling Load Range Block Size
    ,                              !- Account for Dedicated Outdoor Air System [Yes/No]
    ,                              !- Dedicated Outdoor Air System Sizing Option
    ,                              !- Dedicated Outdoor Air Low Setpoint Temperature
    ,                              !- Dedicated Outdoor Air High Setpoint Temperature
    ;                              !- Zone Load Sensible Heat Ratio


!=======================================================================
! HVAC TEMPLATE THERMOSTAT
!
! This is intentionally omitted because the direct thermostat above
! is easier to use later with the EnergyPlus Python API.
!=======================================================================


!=======================================================================
! HVAC AVAILABILITY
!=======================================================================

Schedule:Constant,
    HVAC Availability Schedule,   !- Name
    Fraction,                      !- Schedule Type Limits Name
    1.0;                           !- Hourly Value (1.0 = System available continuously 24/7)


!=======================================================================
! HVAC
!
! Explicit PTAC configuration to avoid unsupported HVACTemplate:* objects.
! Cooling coil: DX, Heating: Electric, Outdoor air: mixed via PTAC box.
!=======================================================================

ScheduleTypeLimits,
    HVACTemplate Any Number;      !- Name (Unconstrained numeric type limits)


Schedule:Compact,
    HVACTemplate-Always 4,        !- Name
    HVACTemplate Any Number,      !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1
    For: AllDays,                  !- Field 2
    Until: 24:00, 4;               !- Field 3-4 (Constant value 4 for Dual Setpoint control)


Schedule:Compact,
    HVACTemplate-Always 0,        !- Name
    HVACTemplate Any Number,      !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1
    For: AllDays,                  !- Field 2
    Until: 24:00, 0;               !- Field 3-4 (Constant value 0)


Schedule:Compact,
    HVACTemplate-Always 1,        !- Name
    HVACTemplate Any Number,      !- Schedule Type Limits Name
    Through: 12/31,                !- Field 1
    For: AllDays,                  !- Field 2
    Until: 24:00, 1;               !- Field 3-4 (Constant value 1)


ZoneHVAC:EquipmentConnections,
    Main Zone,                     !- Zone Name
    Main Zone PTAC Equipment,      !- Zone Conditioning Equipment List Name
    Main Zone PTAC PTAC Supply Inlet, !- Zone Air Inlet Node or NodeList Name
    Main Zone PTAC PTAC Return,    !- Zone Air Exhaust Node or NodeList Name
    Main Zone PTAC Zone Air Node,  !- Zone Air Node Name
    Main Zone PTAC Return Outlet;  !- Zone Return Air Node or NodeList Name


ZoneHVAC:EquipmentList,
    Main Zone PTAC Equipment,      !- Name
    SequentialLoad,                !- Load Distribution Scheme
    ZoneHVAC:PackagedTerminalAirConditioner, !- Zone Equipment Object Type 1
    Main Zone PTAC PTAC,           !- Zone Equipment Name 1
    1,                             !- Zone Equipment Cooling Sequence 1
    1,                             !- Zone Equipment Heating or No-Load Sequence 1
    ,                              !- Zone Equipment Sequential Cooling Fraction Schedule 1
    ;                              !- Zone Equipment Sequential Heating Fraction Schedule 1


ZoneHVAC:PackagedTerminalAirConditioner,
    Main Zone PTAC PTAC,           !- Name
    HVAC Availability Schedule,    !- Availability Schedule Name
    Main Zone PTAC PTAC Return,    !- Air Inlet Node Name
    Main Zone PTAC PTAC Supply Inlet, !- Air Outlet Node Name
    OutdoorAir:Mixer,              !- Outdoor Air Mixer Object Type
    Main Zone PTAC PTAC OA Mixing Box, !- Outdoor Air Mixer Name
    autosize,                      !- Cooling Supply Air Flow Rate [m3/s]
    autosize,                      !- Heating Supply Air Flow Rate [m3/s]
    ,                              !- No Load Supply Air Flow Rate [m3/s]
    ,                              !- Outdoor Air Flow Rate During Cooling [m3/s]
    autosize,                      !- Outdoor Air Flow Rate During Heating [m3/s]
    autosize,                      !- Outdoor Air Flow Rate When No Cooling or Heating is Needed [m3/s]
    autosize,                      !- Supply Air Fan Operating Mode Schedule Name
    Fan:OnOff,                     !- Supply Air Fan Object Type
    Main Zone PTAC PTAC Supply Fan, !- Supply Air Fan Name
    Coil:Heating:Electric,         !- Heating Coil Object Type
    Main Zone PTAC PTAC Heating Coil, !- Heating Coil Name
    Coil:Cooling:DX:SingleSpeed,   !- Cooling Coil Object Type
    Main Zone PTAC PTAC Cooling Coil, !- Cooling Coil Name
    DrawThrough,                   !- Fan Placement
    HVACTemplate-Always 0;         !- Supply Air Fan Operating Mode Schedule Name (0 = Cycling Fan / Continuous Coil)


Fan:OnOff,
    Main Zone PTAC PTAC Supply Fan, !- Name
    HVACTemplate-Always 1,         !- Availability Schedule Name
    0.7,                           !- Fan Total Efficiency
    75,                            !- Pressure Rise [Pa]
    autosize,                      !- Maximum Flow Rate [m3/s]
    0.9,                           !- Motor Efficiency
    1,                             !- Motor In Airstream Fraction
    Main Zone PTAC PTAC Heating Coil Outlet, !- Air Inlet Node Name
    Main Zone PTAC PTAC Supply Inlet; !- Air Outlet Node Name


OutdoorAir:Mixer,
    Main Zone PTAC PTAC OA Mixing Box, !- Name
    Main Zone PTAC PTAC Mixed Air Outlet, !- Mixed Air Node Name
    Main Zone PTAC PTAC Outside Air Inlet, !- Outdoor Air Stream Node Name
    Main Zone PTAC PTAC Relief Air Outlet, !- Relief Air Stream Node Name
    Main Zone PTAC PTAC Return;    !- Return Air Stream Node Name


OutdoorAir:Node,
    Main Zone PTAC PTAC Outside Air Inlet, !- Name
    -1;                            !- Height Above Ground [m] (-1 = Use Zone Default)


Coil:Cooling:DX:SingleSpeed,
    Main Zone PTAC PTAC Cooling Coil, !- Name
    ,                              !- Availability Schedule Name
    autosize,                      !- Gross Rated Total Cooling Capacity [W]
    autosize,                      !- Gross Rated Sensible Heat Ratio
    3,                             !- Gross Rated Cooling COP [W/W]
    autosize,                      !- Rated Air Flow Rate [m3/s]
    ,                              !- Rated Evaporator Fan Power Per Volume Flow Rate [W/(m3/s)]
    ,                              !- Rated Evaporator Fan Power Per Volume Flow Rate 2017 [W/(m3/s)]
    Main Zone PTAC PTAC Mixed Air Outlet, !- Air Inlet Node Name
    Main Zone PTAC PTAC Cooling Coil Outlet, !- Air Outlet Node Name
    Main Zone PTAC PTAC Cooling Coil Cap-FT, !- Total Cooling Capacity Function of Temperature Curve Name
    Main Zone PTAC PTAC Cooling Coil Cap-FF, !- Total Cooling Capacity Function of Flow Fraction Curve Name
    Main Zone PTAC PTAC Cooling Coil EIR-FT, !- Energy Input Ratio Function of Temperature Curve Name
    Main Zone PTAC PTAC Cooling Coil EIR-FF, !- Energy Input Ratio Function of Flow Fraction Curve Name
    Main Zone PTAC PTAC Cooling Coil Coil PLF, !- Part Load Fraction Correlation Curve Name
    ,                              !- Minimum Outdoor Dry-Bulb Temperature for Compressor Operation [C]
    0,                             !- Nominal Time for Condensate Removal To Begin [s]
    0,                             !- Ratio of Initial Moisture Evaporation Rate to Steady State Thermal Capacity
    0,                             !- Maximum Cycling Rate [cycles/hr]
    0,                             !- Latent Capacity Time Constant [s]
    Main Zone PTAC PTAC Cooling Coil Condenser Inlet, !- Condenser Air Inlet Node Name
    AirCooled,                     !- Condenser Type
    0,                             !- Evaporative Condenser Effectiveness
    ,                              !- Evaporative Condenser Air Flow Rate [m3/s]
    0,                             !- Evaporative Condenser Pump Rated Power Consumption [W]
    0,                             !- Crankcase Heater Capacity [W]
    ,                              !- Maximum Outdoor Dry-Bulb Temperature for Crankcase Heater Operation [C]
    10;                            !- Supply Water Storage Tank Name


Curve:Biquadratic,
    Main Zone PTAC PTAC Cooling Coil Cap-FT, !- Name
    0.942587793,                   !- Coefficient1 Constant
    0.009543347,                   !- Coefficient2 x
    0.00068377,                    !- Coefficient3 x**2
    -0.011042676,                  !- Coefficient4 y
    0.000005249,                   !- Coefficient5 y**2
    -0.00000972,                   !- Coefficient6 x*y
    12.77778,                      !- Minimum Value of x [C] (Wet-Bulb Temp)
    23.88889,                      !- Maximum Value of x [C]
    18.0,                          !- Minimum Value of y [C] (Outdoor Dry-Bulb Temp)
    46.11111;                      !- Maximum Value of y [C]


Curve:Quadratic,
    Main Zone PTAC PTAC Cooling Coil Cap-FF, !- Name
    0.8,                           !- Coefficient1 Constant
    0.2,                           !- Coefficient2 x
    0,                             !- Coefficient3 x**2
    0.5,                           !- Minimum Value of x
    1.5;                           !- Maximum Value of x


Curve:Biquadratic,
    Main Zone PTAC PTAC Cooling Coil EIR-FT, !- Name
    0.342414409,                   !- Coefficient1 Constant
    0.034885008,                   !- Coefficient2 x
    -0.0006237,                    !- Coefficient3 x**2
    0.004977216,                   !- Coefficient4 y
    0.000437951,                   !- Coefficient5 y**2
    -0.000728028,                  !- Coefficient6 x*y
    12.77778,                      !- Minimum Value of x [C]
    23.88889,                      !- Maximum Value of x [C]
    18.0,                          !- Minimum Value of y [C]
    46.11111;                      !- Maximum Value of y [C]


Curve:Quadratic,
    Main Zone PTAC PTAC Cooling Coil EIR-FF, !- Name
    1.1552,                        !- Coefficient1 Constant
    -0.1808,                       !- Coefficient2 x
    0.0256,                        !- Coefficient3 x**2
    0.5,                           !- Minimum Value of x
    1.5;                           !- Maximum Value of x


Curve:Quadratic,
    Main Zone PTAC PTAC Cooling Coil Coil PLF, !- Name
    0.85,                          !- Coefficient1 Constant
    0.15,                          !- Coefficient2 x
    0,                             !- Coefficient3 x**2
    0,                             !- Minimum Value of x
    1;                             !- Maximum Value of x


OutdoorAir:Node,
    Main Zone PTAC PTAC Cooling Coil Condenser Inlet, !- Name
    -1;                            !- Height Above Ground [m] (-1 = Use Zone Default)


Coil:Heating:Electric,
    Main Zone PTAC PTAC Heating Coil, !- Name
    ,                              !- Availability Schedule Name
    1,                             !- Efficiency
    autosize,                      !- Nominal Capacity [W]
    Main Zone PTAC PTAC Cooling Coil Outlet, !- Air Inlet Node Name
    Main Zone PTAC PTAC Heating Coil Outlet, !- Air Outlet Node Name
    ;                              !- Temperature Setpoint Node Name


!=======================================================================
! OUTPUT VARIABLES
!=======================================================================

Output:Variable,
    Main Zone,                     !- Key Value (Target zone)
    Zone Mean Air Temperature,     !- Variable Name [C]
    Timestep;                      !- Reporting Frequency (15-minute interval data)


Output:Variable,
    Main Zone,                     !- Key Value (Target zone)
    Zone Air Relative Humidity,    !- Variable Name [%]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    *,                             !- Key Value (* = All sites / environment)
    Site Outdoor Air Drybulb Temperature, !- Variable Name [C]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    *,                             !- Key Value (* = All sites / environment)
    Site Outdoor Air Relative Humidity, !- Variable Name [%]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    Main Zone,                     !- Key Value
    Zone Thermostat Cooling Setpoint Temperature, !- Variable Name [C]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    Main Zone,                     !- Key Value
    Zone Thermostat Heating Setpoint Temperature, !- Variable Name [C]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Cooling Rate, !- Variable Name [W]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Cooling Energy, !- Variable Name [J]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Heating Rate, !- Variable Name [W]
    Timestep;                      !- Reporting Frequency


Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Heating Energy, !- Variable Name [J]
    Timestep;                      !- Reporting Frequency


!=======================================================================
! ENERGY METERS
!=======================================================================

Output:Meter,
    Electricity:HVAC,              !- Key Name (Total electrical energy consumption across all HVAC equipment)
    Timestep;                      !- Reporting Frequency (15-minute interval power tracking)


Output:Meter,
    Electricity:Facility,          !- Key Name (Total facility electrical consumption including fans, lights, equipment)
    Timestep;                      !- Reporting Frequency


Output:Meter,
    Cooling:Electricity,           !- Key Name (Specific electrical energy consumed exclusively by cooling equipment)
    Timestep;                      !- Reporting Frequency


!=======================================================================
! REPORT VARIABLE DICTIONARY
!
! This will help us identify the exact variables generated by the
! expanded PTAC model.
!=======================================================================

Output:VariableDictionary,
    Regular;                       !- Key Field (Generates .rdd and .mdd files sorted alphabetically)


!=======================================================================
! SUMMARY REPORTS
!=======================================================================

Output:Table:SummaryReports,
    AllSummary;                    !- Report 1 Name (Generates all standard summary reports including ABUPS)


OutputControl:Table:Style,
    Comma;                         !- Table Style (Outputs tabular results in CSV format)


Output:SQLite,
    SimpleAndTabular;              !- Option Type (Exports structured simulation results, metadata, and tables to SQLite database)

!=======================================================================
! RUN PERIOD
!
! First test:
! Jan 1 - Dec 31
!
! After successful validation we will change this to:
! January 1 - December 31
!=======================================================================

RunPeriod,
    Dubai Jan Test,               !- Name
    1,                             !- Begin Month (January)
    1,                             !- Begin Day of Month
    ,                              !- Begin Year (Unspecified / Uses Weather File Year)
    12,                            !- End Month (December)
    31,                            !- End Day of Month
    ,                              !- End Year (Unspecified / Uses Weather File Year)
    Tuesday,                       !- Day of Week for Start Day
    Yes,                           !- Use Weather File Holidays and Special Days
    Yes,                           !- Use Weather File Daylight Saving Period
    No,                            !- Apply Weekend Holiday Rule
    Yes,                           !- Use Weather File Rain Indicators
    No;                            !- Use Weather File Snow Indicators


!=======================================================================
! END
!=======================================================================