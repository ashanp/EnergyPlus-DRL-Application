!=======================================================================
! UAE DUBAI HVAC BASELINE MODEL
! EnergyPlus 26.1.0
!
! Location:
!   Dubai World Central / Al Maktoum International Airport
!
! Weather:
!   ARE_DU_Dubai.World.Central.Intl.AP-Maktoum.Intl.AP.411945_TMYx.2007-2021.epw
!
! Building:
!   Single zone
!   10m x 10m x 3m
!   100 m2 floor area
!   300 m3 approximate volume
!
! HVAC:
!   Packaged Terminal Air Conditioner
!   DX cooling
!   Electric heating
!   Autosized
!
! Cooling thermostat:
!   24 C
!
! Designed as a baseline for later:
!   PPO / DQN HVAC optimisation
!
!=======================================================================


Version,
    26.1;


!=======================================================================
! SIMULATION CONTROL
!=======================================================================

SimulationControl,
    Yes,             !- Do Zone Sizing Calculation
    Yes,             !- Do System Sizing Calculation
    No,              !- Do Plant Sizing Calculation
    Yes,             !- Run Simulation for Sizing Periods
    Yes;             !- Run Simulation for Weather File Run Periods


SizingPeriod:DesignDay,
    Dubai Winter 99% Design Conditions, !- Name
    1,                        !- Month
    21,                       !- Day of Month
    WinterDesignDay,          !- Day Type
    11.0,                     !- Maximum Dry-Bulb Temperature [C]
    0.0,                      !- Daily Dry-Bulb Temperature Range [C]
    ,                         !- Default Safety Factor
    ,                         !- Fraction of Daily Range Schedule Name
    WetBulb,                  !- Humidity Condition Type
    11.0,                     !- Wetbulb or DewPoint at Maximum Dry-Bulb [C]
    ,                         !- Humidity Condition Day Schedule Name
    ,                         !- Humidity Ratio at Maximum Dry-Bulb [kgWater/kgDryAir]
    ,                         !- Enthalpy at Maximum Dry-Bulb [J/kg]
    ,                         !- Daily Wet-Bulb Temperature Range [C]
    101325.0,                 !- Barometric Pressure [Pa]
    3.0,                      !- Wind Speed [m/s]
    180,                      !- Wind Direction [deg]
    No,                       !- Rain Indicator
    No,                       !- Snow Indicator
    No,                       !- Daylight Saving Time Indicator
    ASHRAEClearSky,           !- Solar Model Indicator
    ,                         !- Beam Solar Day Schedule Name
    ,                         !- Diffuse Solar Day Schedule Name
    ,                         !- ASHRAE Clear Sky Optical Depth For Beam Irradiance (taub)
    ,                         !- ASHRAE Clear Sky Optical Depth For Diffuse Irradiance (taud)
    0.0;                      !- Sky Clearness (0.0 = No Solar Gain)


SizingPeriod:DesignDay,
    Dubai Summer 1% Design Conditions,
    7,
    21,
    SummerDesignDay,
    42.0,
    9.0,
    ,
    ,
    WetBulb,
    27.0,
    ,
    ,
    ,
    ,
    101325.0,
    3.0,
    180,
    No,
    No,
    No,
    ASHRAEClearSky,
    ,
    ,
    ,
    ,
    1.0;


Timestep,
    4;


!=======================================================================
! BUILDING
!=======================================================================

Building,
    UAE Dubai Baseline,
    0.0,
    Suburbs,
    0.04,
    0.4,
    FullExteriorWithReflections,
    25;


!=======================================================================
! LOCATION
!
! The EPW file supplied with -w is the actual weather source.
!=======================================================================

Site:Location,
    Dubai World Central,
    24.896,
    55.161,
    4.0,
    36.0;                    !- Elevation [m]


!=======================================================================
! GROUND TEMPERATURE
!=======================================================================

Site:GroundTemperature:BuildingSurface,
    24.0,
    24.0,
    25.0,
    27.0,
    30.0,
    32.0,
    33.0,
    33.0,
    32.0,
    30.0,
    27.0,
    25.0;


!=======================================================================
! GLOBAL GEOMETRY
!=======================================================================

GlobalGeometryRules,
    UpperLeftCorner,
    CounterClockWise,
    World;


!=======================================================================
! ZONE
!=======================================================================

Zone,
    Main Zone,               !- Name
    0.0,                     !- Direction of Relative North [deg]
    0.0,                     !- X Origin [m]
    0.0,                     !- Y Origin [m]
    0.0,                     !- Z Origin [m]
    1,                       !- Type
    1,                       !- Multiplier
    autocalculate,           !- Ceiling Height [m]
    autocalculate;           !- Volume [m3]


!=======================================================================
! MATERIALS
!=======================================================================

Material,
    External Wall Material,
    MediumRough,
    0.200,
    1.40,
    2200.0,
    900.0,
    0.90,
    0.70,
    0.70;


Material,
    Roof Material,
    MediumRough,
    0.180,
    1.40,
    2200.0,
    900.0,
    0.90,
    0.70,
    0.70;


