    0.6852,                        !- Coefficient 2 of Full Load Ratio Curve
    0.2818,                        !- Coefficient 3 of Full Load Ratio Curve
    2.0,                           !- Chilled Water Outlet Temperature Lower Limit [C]
    LeavingSetpointModulated;      !- Chiller Flow Mode


OutdoorAir:Node,
    Main Chiller Condenser Inlet Node, !- Name
    -1.0;                          !- Height Above Ground [m] (-1 = Use Zone Default)


!=======================================================================
! OUTPUT VARIABLES
!=======================================================================

!- Zone Thermal States
Output:Variable,
    Main Zone,                     !- Key Value
    Zone Mean Air Temperature,     !- Variable Name [C]
    Timestep;                      !- Reporting Frequency (15-minute interval)

Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air Relative Humidity,    !- Variable Name [%]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone,                     !- Key Value
    Zone Thermostat Cooling Setpoint Temperature, !- Variable Name [C]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone,                     !- Key Value
    Zone Thermostat Heating Setpoint Temperature, !- Variable Name [C]
    Timestep;                      !- Reporting Frequency

!- Occupancy
Output:Variable,
    Main Zone,                     !- Key Value
    Zone People Occupant Count,    !- Variable Name [person]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Occupancy Schedule,            !- Key Value
    Schedule Value,                !- Variable Name [Fractional multiplier 0.0 to 1.0]
    Timestep;                      !- Reporting Frequency

!- Ambient Weather & Day Type
Output:Variable,
    *,                             !- Key Value (* = Environment / Site)
    Site Outdoor Air Drybulb Temperature, !- Variable Name [C]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    *,                             !- Key Value (* = Environment / Site)
    Site Outdoor Air Relative Humidity, !- Variable Name [%]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    *,                             !- Key Value (* = Environment / Site)
    Site Day Type Index,           !- Variable Name [1=Sun, 2=Mon... 9=SummerDesignDay]
    Timestep;                      !- Reporting Frequency

!- Solar Radiation (Direct Beam and Sky Diffuse)
Output:Variable,
    *,                             !- Key Value (* = Environment / Site)
    Site Direct Solar Radiation Rate per Area, !- Variable Name [W/m2]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    *,                             !- Key Value (* = Environment / Site)
    Site Diffuse Solar Radiation Rate per Area, !- Variable Name [W/m2]
    Timestep;                      !- Reporting Frequency

!- HVAC Thermal Rates and Energy
Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Cooling Rate, !- Variable Name [W]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Cooling Energy, !- Variable Name [J]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Heating Rate, !- Variable Name [W]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone,                     !- Key Value
    Zone Air System Sensible Heating Energy, !- Variable Name [J]
    Timestep;                      !- Reporting Frequency

!- Chilled Water Cooling Coil
Output:Variable,
    Main Zone FCU Cooling Coil Water Inlet, !- Key Value
    System Node Temperature,       !- Variable Name [C] (Cooling coil water inlet temperature)
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone FCU Cooling Coil Water Outlet, !- Key Value
    System Node Temperature,       !- Variable Name [C] (Cooling coil water outlet temperature)
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone FCU Cooling Coil Water Inlet, !- Key Value
    System Node Mass Flow Rate,    !- Variable Name [kg/s] (Cooling coil water mass flow rate)
    Timestep;                      !- Reporting Frequency

Output:Variable,
    Main Zone FCU Cooling Coil,    !- Key Value
    Cooling Coil Total Cooling Rate, !- Variable Name [W]
    Timestep;                      !- Reporting Frequency

!- Chilled Water Pump
Output:Variable,
    CHW Circ Pump,                 !- Key Value
    Pump Mass Flow Rate,           !- Variable Name [kg/s]
    Timestep;                      !- Reporting Frequency

Output:Variable,
    CHW Circ Pump,                 !- Key Value
    Pump Electricity Rate,         !- Variable Name [W]
    Timestep;                      !- Reporting Frequency

!- Chilled Water Plant Loop Supply/Return Temperature
Output:Variable,
    CHW Supply Outlet Node,        !- Key Value
    System Node Temperature,       !- Variable Name [C] (Plant-loop supply temperature)
    Timestep;                      !- Reporting Frequency

Output:Variable,
    CHW Demand Outlet Node,        !- Key Value
    System Node Temperature,       !- Variable Name [C] (Plant-loop return temperature)
    Timestep;                      !- Reporting Frequency

!=======================================================================
! ENERGY METERS
!=======================================================================

Output:Meter,
    Electricity:HVAC,              !- Key Name (Total electrical energy consumption across all HVAC equipment)
    Timestep;                      !- Reporting Frequency (15-minute interval power tracking)


Output:Meter,
    Electricity:Facility,          !- Key Name (Total facility electrical consumption including fans, lights, equipment)
    Timestep;                      !- Reporting Frequency


Output:Meter,
    Cooling:Electricity,           !- Key Name (Specific electrical energy consumed exclusively by cooling equipment)
    Timestep;                      !- Reporting Frequency


!=======================================================================
! REPORT VARIABLE DICTIONARY
!
! This will help us identify the exact variables generated by the
! expanded PTAC model.
!=======================================================================

Output:VariableDictionary,
    Regular;                       !- Key Field (Generates .rdd and .mdd files sorted alphabetically)


!=======================================================================
! SUMMARY REPORTS
!=======================================================================

Output:Table:SummaryReports,
    AllSummary;                    !- Report 1 Name (Generates all standard summary reports including ABUPS)


OutputControl:Table:Style,
    Comma;                         !- Table Style (Outputs tabular results in CSV format)


Output:SQLite,
    SimpleAndTabular;              !- Option Type (Exports structured simulation results, metadata, and tables to SQLite database)

!=======================================================================
! RUN PERIOD
!
! First test:
! Jan 1 - Dec 31
!
! After successful validation we will change this to:
! January 1 - December 31
!=======================================================================

RunPeriod,
    Dubai Jan Test,               !- Name
    1,                             !- Begin Month (January)
    1,                             !- Begin Day of Month
    ,                              !- Begin Year (Unspecified / Uses Weather File Year)
    12,                            !- End Month (December)
    31,                            !- End Day of Month
    ,                              !- End Year (Unspecified / Uses Weather File Year)
    Tuesday,                       !- Day of Week for Start Day
    Yes,                           !- Use Weather File Holidays and Special Days
    Yes,                           !- Use Weather File Daylight Saving Period
    No,                            !- Apply Weekend Holiday Rule
    Yes,                           !- Use Weather File Rain Indicators
    No;                            !- Use Weather File Snow Indicators


!=======================================================================
! END
