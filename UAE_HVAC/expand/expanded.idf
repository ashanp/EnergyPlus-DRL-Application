BuildingSurface:Detailed,
    South Wall,
    Wall,
    External Wall Construction,
    Main Zone,
    Outdoors,
    ,
    SunExposed,
    WindExposed,
    0.5,
    4,
    0.0,
    0.0,
    3.0,
