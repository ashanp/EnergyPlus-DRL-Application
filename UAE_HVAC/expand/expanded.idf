  Main Zone PTAC PTAC Supply Inlet;                        !- Air Outlet Node Name

Schedule:Compact,
  HVACTemplate-Always 1,                                   !- Name
  HVACTemplate Any Number,                                 !- Schedule Type Limits Name
  Through: 12/31,                                          !- Field 1
  For: AllDays,                                            !- Field 2
  Until: 24:00,                                            !- Field 3
  1;                                                       !- Field 4

OutdoorAir:Mixer,
  Main Zone PTAC PTAC OA Mixing Box,                       !- Name
  Main Zone PTAC PTAC Mixed Air Outlet,                    !- Mixed Air Node Name
  Main Zone PTAC PTAC Outside Air Inlet,                   !- Outside Air Stream Node Name
  Main Zone PTAC PTAC Relief Air Outlet,                   !- Relief Air Stream Node Name
  Main Zone PTAC PTAC Return;                              !- Return Air Stream Node Name

OutdoorAir:Node,
  Main Zone PTAC PTAC Outside Air Inlet,                   !- Name
  -1;                                                      !- Height Above Ground

Coil:Cooling:DX:SingleSpeed,
  Main Zone PTAC PTAC Cooling Coil,                        !- Name
