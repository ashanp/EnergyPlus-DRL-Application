!=======================================================================
! SCHEDULE TYPE LIMITS
!=======================================================================

ScheduleTypeLimits,
    Fraction,
    0.0,
    1.0,
    Continuous;


ScheduleTypeLimits,
    Temperature,
    -60.0,
    200.0,
    Continuous;


ScheduleTypeLimits,
    Control Type,
    0,
    4,
    Discrete;


!=======================================================================
! OCCUPANCY
!=======================================================================

Schedule:Compact,
    Occupancy Schedule,
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 08:00,
    0.0,
    Until: 09:00,
    0.5,
    Until: 18:00,
    1.0,
    Until: 19:00,
    0.5,
    Until: 24:00,
    0.0,
    For: Weekends,
    Until: 24:00,
    0.0;


People,
    Main Zone Occupants,
    Main Zone,
    Occupancy Schedule,
    People,
    10,
    ,
    0.3,
    0.5;


!=======================================================================
! LIGHTING
!=======================================================================

Schedule:Compact,
    Lighting Schedule,
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 08:00,
    0.1,
    Until: 09:00,
    0.5,
    Until: 18:00,
    1.0,
    Until: 19:00,
    0.5,
    Until: 24:00,
    0.1,
    For: Weekends,
    Until: 24:00,
    0.1;


Lights,
    Main Zone Lights,
    Main Zone,
    Lighting Schedule,
    LightingLevel,
    800.0,
    ,
    0.42,
    0.18,
    1.0;


!=======================================================================
! ELECTRICAL EQUIPMENT
!=======================================================================

Schedule:Compact,
    Equipment Schedule,
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 08:00,
    0.1,
    Until: 09:00,
    0.5,
    Until: 18:00,
    1.0,
    Until: 19:00,
    0.5,
    Until: 24:00,
    0.1,
    For: Weekends,
    Until: 24:00,
    0.1;


ElectricEquipment,
    Main Zone Equipment,
    Main Zone,
    Equipment Schedule,
    EquipmentLevel,
    1000.0,
    ,
    0.30,
    0.0,
    General;


!=======================================================================
! INFILTRATION
!=======================================================================

Schedule:Constant,
    Infiltration Schedule,
    Fraction,
    1.0;


ZoneInfiltration:DesignFlowRate,
    Main Zone Infiltration,
    Main Zone,
    Infiltration Schedule,
    Flow/Zone,
    0.0003,
    ,
    ,
    ,
    0.0;


!=======================================================================
! THERMOSTAT
!
! Heating = 20 C
! Cooling = 24 C
!=======================================================================

Schedule:Compact,
    Heating Setpoint Schedule,
    Temperature,
    Through: 12/31,
    For: AllDays,
    Until: 24:00,
    20.0;


Schedule:Compact,
    Cooling Setpoint Schedule,
    Temperature,
    Through: 12/31,
    For: AllDays,
    Until: 24:00,
    24.0;


Schedule:Compact,
    Thermostat Control Schedule,
    Control Type,
    Through: 12/31,
    For: AllDays,
    Until: 24:00,
    4;


ThermostatSetpoint:DualSetpoint,
    Main Zone Dual Setpoint,
    Heating Setpoint Schedule,
    Cooling Setpoint Schedule;


ZoneControl:Thermostat,
    Main Zone Thermostat,
    Main Zone,
    Thermostat Control Schedule,
    DualSetpoint,
    Main Zone Dual Setpoint;


!=======================================================================
! HVAC TEMPLATE THERMOSTAT
!
! This is intentionally omitted because the direct thermostat above
! is easier to use later with the EnergyPlus Python API.
!=======================================================================


!=======================================================================
! HVAC AVAILABILITY
!=======================================================================

Schedule:Constant,
    HVAC Availability Schedule,
    Fraction,
    1.0;
! 
! 
!=======================================================================
! HVAC
!
! Use EnergyPlus HVAC Template to generate a PTAC with DX cooling.
!
! Cooling coil:
!   DX
!
! Heating:
!   Electric
!
! Outdoor air:
!   0.005 m3/s
!
! Cooling setpoint is controlled by the thermostat above.
!=======================================================================
! 
! HVACTemplate:Zone:PTAC,
!     Main Zone PTAC,
!     Main Zone,
!     HVAC Availability Schedule,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ,
!     ;


!=======================================================================
! OUTPUT VARIABLES
!=======================================================================

Output:Variable,
    Main Zone,
    Zone Mean Air Temperature,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air Relative Humidity,
    Timestep;


Output:Variable,
    *,
    Site Outdoor Air Drybulb Temperature,
    Timestep;


Output:Variable,
    *,
    Site Outdoor Air Relative Humidity,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Thermostat Cooling Setpoint Temperature,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Thermostat Heating Setpoint Temperature,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Cooling Rate,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Cooling Energy,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Heating Rate,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Heating Energy,
    Timestep;


!=======================================================================
! ENERGY METERS
!=======================================================================

Output:Meter,
    Electricity:HVAC,
    Timestep;


Output:Meter,
    Electricity:Facility,
    Timestep;


Output:Meter,
    Electricity:Cooling,
    Timestep;


!=======================================================================
! REPORT VARIABLE DICTIONARY
!
! This will help us identify the exact variables generated by the
! expanded PTAC model.
!=======================================================================

Output:VariableDictionary,
    Regular;


!=======================================================================
! SUMMARY REPORTS
!=======================================================================

Output:Table:SummaryReports,
    AllSummary;


OutputControl:Table:Style,
    Comma;


Output:SQLite,
    SimpleAndTabular;


!=======================================================================
! RUN PERIOD
!
! First test:
! July 1 - July 3
!
! After successful validation we will change this to:
! January 1 - December 31
!=======================================================================

RunPeriod,
    Dubai July Test,
    7,
    1,
    7,
    3,
    Tuesday,
    Yes,
    Yes,
    No,
    Yes,
    No;
! 
! Cannot find Energy+.idd as specified in Energy+.ini.
! 
! Since the Energy+.IDD file cannot be read no range or choice checking was performed.
! 
! -------------------------------------------------------------
! New objects created from ExpandObjects
! -------------------------------------------------------------
! 

ScheduleTypeLimits,
  HVACTemplate Any Number;                                 !- Name

Schedule:Compact,
  HVACTemplate-Always 4,                                   !- Name
  HVACTemplate Any Number,                                 !- Schedule Type Limits Name
  Through: 12/31,                                          !- Field 1
  For: AllDays,                                            !- Field 2
  Until: 24:00,                                            !- Field 3
  4;                                                       !- Field 4

ZoneControl:Thermostat,
  Main Zone PTAC Thermostat,                               !- Name
  Main Zone PTAC,                                          !- Zone or ZoneList Name
  HVACTemplate-Always 4,                                   !- Control Type Schedule Name
  ThermostatSetpoint:DualSetpoint,                         !- Control Object Type
  Main Zone Dual SP Control;                               !- Control Name

DesignSpecification:OutdoorAir,
  SZ DSOA Main Zone PTAC,                                  !- Name
  Flow/Person,                                             !- Outdoor Air Method
  0.00944,                                                 !- Outdoor Air Flow per Person {m3/s}
  0.0,                                                     !- Outdoor Air Flow per Zone Floor Area {m3/s-m2}
  0.0;                                                     !- Outdoor Air Flow per Zone {m3/s}

Sizing:Zone,
  Main Zone PTAC,                                          !- Zone or ZoneList Name
  SupplyAirTemperature,                                    !- Zone Cooling Design Supply Air Temperature Input Method
  14.0,                                                    !- Zone Cooling Design Supply Air Temperature {C}
  11.11,                                                   !- Zone Cooling Design Supply Air Temperature Difference {delta C}
  SupplyAirTemperature,                                    !- Zone Heating Design Supply Air Temperature Input Method
  50.0,                                                    !- Zone Heating Design Supply Air Temperature {C}
  ,                                                        !- Zone Heating Design Supply Air Temperature Difference {delta C}
  0.008,                                                   !- Zone Cooling Design Supply Air Humidity Ratio {kg-H20/kg-air}
  0.008,                                                   !- Zone Heating Design Supply Air Humidity Ratio {kg-H2O/kg-air}
  SZ DSOA Main Zone PTAC,                                  !- Design Specification Outdoor Air Object Name
  ,                                                        !- Zone Heating Sizing Factor
  ,                                                        !- Zone Cooling Sizing Factor
  Flow/Zone,                                               !- Cooling Design Air Flow Method
  HVAC Availability Schedule,                              !- Cooling Design Air Flow Rate {m3/s}
  ,                                                        !- Cooling Minimum Air Flow per Zone Floor Area {m3/s-m2}
  ,                                                        !- Cooling Minimum Air Flow {m3/s}
  0,                                                       !- Cooling Minimum Air Flow Fraction {}
  DesignDay,                                               !- Heating Design Air Flow Method
  0,                                                       !- Heating Design Air Flow Rate {m3/s}
  ,                                                        !- Heating Maximum Air Flow per Zone Floor Area {m3/s-m2}
  ,                                                        !- Heating Maximum Air Flow {m3/s}
  0,                                                       !- Heating Maximum Air Flow Fraction {}
  SZ DSZAD Main Zone PTAC;                                 !- Design Specification Zone Air Distribution Object Name

DesignSpecification:ZoneAirDistribution,
  SZ DSZAD Main Zone PTAC,                                 !- Name
  1,                                                       !- Zone Air Distribution Effectiveness in Cooling Mode {}
  1;                                                       !- Zone Air Distribution Effectiveness in Heating Mode {}

ZoneHVAC:EquipmentConnections,
  Main Zone PTAC,                                          !- Zone Name
  Main Zone PTAC Equipment,                                !- Zone Conditioning Equipment List Name
  Main Zone PTAC PTAC Supply Inlet,                        !- Zone Air Inlet Node or NodeList Name
  Main Zone PTAC PTAC Return,                              !- Zone Air Exhaust Node or NodeList Name
  Main Zone PTAC Zone Air Node,                            !- Zone Air Node Name
  Main Zone PTAC Return Outlet;                            !- Zone Return Air Node Name

ZoneHVAC:EquipmentList,
  Main Zone PTAC Equipment,                                !- Name
  SequentialLoad,                                          !- Load Distribution Scheme
  ZoneHVAC:PackagedTerminalAirConditioner,                 !- Zone Equipment Object Type
  Main Zone PTAC PTAC,                                     !- Zone Equipment Name
  1,                                                       !- Zone Equipment Cooling Sequence
  1,                                                       !- Zone Equipment Heating or No-Load Sequence
  ,                                                        !- Zone Equipment Sequential Cooling Fraction Schedule Name
  ;                                                        !- Zone Equipment Sequential Heating Fraction Schedule Name

ZoneHVAC:PackagedTerminalAirConditioner,
  Main Zone PTAC PTAC,                                     !- Name
  ,                                                        !- Availability Schedule Name
  Main Zone PTAC PTAC Return,                              !- Air Inlet Node Name
  Main Zone PTAC PTAC Supply Inlet,                        !- Air Outlet Node Name
  OutdoorAir:Mixer,                                        !- Outdoor Air Mixer Object Type
  Main Zone PTAC PTAC OA Mixing Box,                       !- Outdoor Air Mixer Name
  autosize,                                                !- Cooling Supply Air Flow Rate {m3/s}
  autosize,                                                !- Heating Supply Air Flow Rate {m3/s}
  ,                                                        !- No Load Supply Air Flow Rate {m3/s}
  ,                                                        !- No Load Supply Air Flow Rate Control Set To Low Speed
  autosize,                                                !- Cooling Outdoor Air Flow Rate {m3/s}
  autosize,                                                !- Heating Outdoor Air Flow Rate {m3/s}
  autosize,                                                !- No Load Outdoor Air Flow Rate {m3/s}
  Fan:OnOff,                                               !- Supply Air Fan Object Type
  Main Zone PTAC PTAC Supply Fan,                          !- Supply Air Fan Name
  Coil:Heating:Electric,                                   !- Heating Coil Object Type
  Main Zone PTAC PTAC Heating Coil,                        !- Heating Coil Name
  Coil:Cooling:DX:SingleSpeed,                             !- Cooling Coil Object Type
  Main Zone PTAC PTAC Cooling Coil,                        !- Cooling Coil Name
  DrawThrough,                                             !- Fan Placement
  HVACTemplate-Always 0;                                   !- Supply Air Fan Operating Mode Schedule Name

Schedule:Compact,
  HVACTemplate-Always 0,                                   !- Name
  HVACTemplate Any Number,                                 !- Schedule Type Limits Name
  Through: 12/31,                                          !- Field 1
  For: AllDays,                                            !- Field 2
  Until: 24:00,                                            !- Field 3
  0;                                                       !- Field 4

Fan:OnOff,
  Main Zone PTAC PTAC Supply Fan,                          !- Name
