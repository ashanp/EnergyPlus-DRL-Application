    0.0,
    0.0,
    10.0,
    0.0,
    3.0,
    10.0,
    10.0,
    3.0,
    10.0,
    10.0,
    0.0;


!=======================================================================
! WEST WALL
!=======================================================================

BuildingSurface:Detailed,
    West Wall,
    Wall,
    External Wall Construction,
    Main Zone,
    Outdoors,
    ,
    SunExposed,
    WindExposed,
    0.5,
    4,
    0.0,
