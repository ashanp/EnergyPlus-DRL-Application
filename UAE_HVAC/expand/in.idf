    0.0,
    7.0,
    2.5;


!=======================================================================
! SCHEDULE TYPE LIMITS
!=======================================================================

ScheduleTypeLimits,
    Fraction,
    0.0,
    1.0,
    Continuous;


ScheduleTypeLimits,
    Temperature,
    -60.0,
    200.0,
    Continuous;


ScheduleTypeLimits,
    Control Type,
    0,
    4,
    Discrete;


!=======================================================================
! OCCUPANCY
!=======================================================================

Schedule:Compact,
    Occupancy Schedule,
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 08:00,
    0.0,
    Until: 09:00,
    0.5,
    Until: 18:00,
    1.0,
    Until: 19:00,
    0.5,
    Until: 24:00,
    0.0,
    For: Weekends,
    Until: 24:00,
    0.0;


People,
    Main Zone Occupants,
    Main Zone,
    Occupancy Schedule,
    People,
    10,
    ,
    0.3,
    0.5;


!=======================================================================
! LIGHTING
!=======================================================================

Schedule:Compact,
    Lighting Schedule,
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 08:00,
    0.1,
    Until: 09:00,
    0.5,
    Until: 18:00,
    1.0,
    Until: 19:00,
    0.5,
    Until: 24:00,
    0.1,
    For: Weekends,
    Until: 24:00,
    0.1;


Lights,
    Main Zone Lights,
    Main Zone,
    Lighting Schedule,
    LightingLevel,
    800.0,
    ,
    0.42,
    0.18,
    1.0;


!=======================================================================
! ELECTRICAL EQUIPMENT
!=======================================================================

Schedule:Compact,
    Equipment Schedule,
    Fraction,
    Through: 12/31,
    For: Weekdays,
    Until: 08:00,
    0.1,
    Until: 09:00,
    0.5,
    Until: 18:00,
    1.0,
    Until: 19:00,
    0.5,
    Until: 24:00,
    0.1,
    For: Weekends,
    Until: 24:00,
    0.1;


ElectricEquipment,
    Main Zone Equipment,
    Main Zone,
    Equipment Schedule,
    EquipmentLevel,
    1000.0,
    ,
    0.30,
    0.0,
    General;


!=======================================================================
! INFILTRATION
!=======================================================================

Schedule:Constant,
    Infiltration Schedule,
    Fraction,
    1.0;


ZoneInfiltration:DesignFlowRate,
    Main Zone Infiltration,
    Main Zone,
    Infiltration Schedule,
    Flow/Zone,
    0.0003,
    ,
    ,
    ,
    0.0;


!=======================================================================
! THERMOSTAT
!
! Heating = 20 C
! Cooling = 24 C
!=======================================================================

Schedule:Compact,
    Heating Setpoint Schedule,
    Temperature,
    Through: 12/31,
    For: AllDays,
    Until: 24:00,
    20.0;


Schedule:Compact,
    Cooling Setpoint Schedule,
    Temperature,
    Through: 12/31,
    For: AllDays,
    Until: 24:00,
    24.0;


Schedule:Compact,
    Thermostat Control Schedule,
    Control Type,
    Through: 12/31,
    For: AllDays,
    Until: 24:00,
    4;


ThermostatSetpoint:DualSetpoint,
    Main Zone Dual Setpoint,
    Heating Setpoint Schedule,
    Cooling Setpoint Schedule;


ZoneControl:Thermostat,
    Main Zone Thermostat,
    Main Zone,
    Thermostat Control Schedule,
    DualSetpoint,
    Main Zone Dual Setpoint;


!=======================================================================
! HVAC TEMPLATE THERMOSTAT
!
! This is intentionally omitted because the direct thermostat above
! is easier to use later with the EnergyPlus Python API.
!=======================================================================


!=======================================================================
! HVAC AVAILABILITY
!=======================================================================

Schedule:Constant,
    HVAC Availability Schedule,
    Fraction,
    1.0;


!=======================================================================
! HVAC
!
! Use EnergyPlus HVAC Template to generate a PTAC with DX cooling.
!
! Cooling coil:
!   DX
!
! Heating:
!   Electric
!
! Outdoor air:
!   0.005 m3/s
!
! Cooling setpoint is controlled by the thermostat above.
!=======================================================================

HVACTemplate:Zone:PTAC,
    Main Zone PTAC,
    Main Zone,
    HVAC Availability Schedule,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ,
    ;


!=======================================================================
! OUTPUT VARIABLES
!=======================================================================

Output:Variable,
    Main Zone,
    Zone Mean Air Temperature,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air Relative Humidity,
    Timestep;


Output:Variable,
    *,
    Site Outdoor Air Drybulb Temperature,
    Timestep;


Output:Variable,
    *,
    Site Outdoor Air Relative Humidity,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Thermostat Cooling Setpoint Temperature,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Thermostat Heating Setpoint Temperature,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Cooling Rate,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Cooling Energy,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Heating Rate,
    Timestep;


Output:Variable,
    Main Zone,
    Zone Air System Sensible Heating Energy,
    Timestep;


!=======================================================================
! ENERGY METERS
!=======================================================================

Output:Meter,
    Electricity:HVAC,
    Timestep;


Output:Meter,
    Electricity:Facility,
    Timestep;


Output:Meter,
    Electricity:Cooling,
    Timestep;


!=======================================================================
! REPORT VARIABLE DICTIONARY
!
! This will help us identify the exact variables generated by the
! expanded PTAC model.
!=======================================================================

Output:VariableDictionary,
    Regular;


!=======================================================================
! SUMMARY REPORTS
!=======================================================================

Output:Table:SummaryReports,
    AllSummary;


OutputControl:Table:Style,
    Comma;


Output:SQLite,
    SimpleAndTabular;


!=======================================================================
! RUN PERIOD
!
! First test:
! July 1 - July 3
!
! After successful validation we will change this to:
! January 1 - December 31
!=======================================================================

RunPeriod,
    Dubai July Test,
    7,
    1,
    7,
    3,
    Tuesday,
    Yes,
    Yes,
    No,
    Yes,
    No;


!=======================================================================
! END
!=======================================================================