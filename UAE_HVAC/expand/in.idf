!=======================================================================
! FLOOR
!=======================================================================

BuildingSurface:Detailed,
    Floor,
    Floor,
    Floor Construction,
    Main Zone,
    Ground,
    ,
    NoSun,
    NoWind,
    0.0,
    4,
    0.0,
    0.0,
    0.0,
    10.0,
    0.0,
    0.0,
    10.0,
    10.0,
    0.0,
    0.0,
    10.0,
    0.0;


!=======================================================================
! WINDOWS
!
! Each window = 4m x 1.5m = 6m2
! Four windows = 24m2
!=======================================================================


!---------------- SOUTH WINDOW ----------------

FenestrationSurface:Detailed,
    South Window,
    Window,
    Window Construction,
    South Wall,
    ,
    1.0,
    4,
    3.0,
    0.0,
    1.0,
    7.0,
    0.0,
    1.0,
    7.0,
    0.0,
    2.5,
    3.0,
    0.0,
    2.5;


!---------------- NORTH WINDOW ----------------

FenestrationSurface:Detailed,
    North Window,
    Window,
    Window Construction,
    North Wall,
    ,
    1.0,
    4,
    7.0,
    10.0,
    1.0,
    3.0,
    10.0,
    1.0,
    3.0,
    10.0,
    2.5,
    7.0,
    10.0,
    2.5;


!---------------- EAST WINDOW ----------------

FenestrationSurface:Detailed,
    East Window,
    Window,
    Window Construction,
    East Wall,
    ,
